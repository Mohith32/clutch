<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- hard offset shadow -->
    <item android:left="4dp" android:top="4dp">
        <shape><solid android:color="#0B0B0F"/><corners android:radius="20dp"/></shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape><solid android:color="#C6F432"/><stroke android:width="3dp" android:color="#0B0B0F"/><corners android:radius="20dp"/></shape>
    </item>
</layer-list>
