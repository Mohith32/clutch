<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/sos_tile">
    <ImageView
        android:id="@+id/sos_qr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/sos_tile"/>
    <LinearLayout
        android:id="@+id/sos_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sos_widget_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_sos"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sos_widget_empty"
            android:textColor="#1C1C21"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
